#!/usr/bin/env python3
"""audit — the append-only, tamper-evident audit log for the Djinn broker.

Phase 2 · Step 2 (see docs/phase2-threat-model.md §8, §12). The SMALLEST privileged
primitive: every capability the broker runs is recorded here FIRST, and if the record
cannot be durably written the action does not run — no-log -> no-execute. The log is
append-only NDJSON with a SHA-256 hash chain, so any NON-RECOMPUTING tampering of a
past record — an in-place edit, a reorder, or a mid-chain deletion — is detectable by
`audit verify` even by an actor who can write the file. What the chain ALONE does NOT
catch: tail-truncation and suffix-rewrite (an actor drops the tail and re-fabricates a
valid canonical chained suffix — there is no secret in the chain to prevent it). Those
are closed by (a) Step-7 OS-level append-only (chattr +a) + directory ownership, the
primary write controls, and (b) the broker anchoring each head hash (echoed on stdout
by `append`) OUTSIDE the audit dir, which makes a suffix-rewrite detectable before
Step 7 lands. So this is tamper-EVIDENCE, not tamper-prevention.

Trust boundary: this runs as the broker (the trusted layer), NEVER as a capability
impl. The log directory (/var/lib/agent-os/audit) is a Step-1 PROTECTED path — no impl
sandbox may write it (asserted in modules/capability-registry.nix). The primitive
assumes a single trusted writer and additionally takes an exclusive lock so concurrent
writers cannot interleave the sequence/chain.

Commands:
  audit append   < record.json     stamp seq+prev+ts, append one line, fsync, echo hash
  audit verify                      walk the chain; exit 0 iff intact, else report break
  audit tail [N]                    read-only: last N records (default 20)

Directory is $AGENT_OS_AUDIT_DIR (default /var/lib/agent-os/audit).
Exit codes: 0 ok; NON-ZERO on ANY failure (fail-closed). The broker MUST gate
execution on `append` returning 0 — a non-zero exit means the action must not run.

SIGNING (Phase 1.5B slice 3, task 287) — $AGENT_OS_AUDIT_SIGNER
--------------------------------------------------------------
Set $AGENT_OS_AUDIT_SIGNER=<participant> and every appended record is BIP-340
signed by that participant (modules/identity.py) over the canonical record bytes,
carrying `signer` + `sig`. Both are RESERVED, so a caller cannot supply either.

What this adds that the chain alone cannot give: the chain has NO SECRET in it, so
an actor who can write the file may drop the tail and re-fabricate a valid canonical
chained suffix. Signatures close that — a suffix-rewriter cannot produce signatures
that verify against the participants' registered pubkeys. The chain hash covers the
FINAL line (signature included), so the two compose rather than layer.

Downgrade is the obvious way to defeat this, so verify guards it WITHOUT config:
once any record in the chain is signed, every LATER record must be signed too. An
attacker who rewrites a signed suffix with unsigned records is caught by that rule,
not by an operator having remembered to set a flag. $AGENT_OS_AUDIT_REQUIRE_SIGNED=1
additionally demands signatures from genesis (for a log born signed).

Signing is FAIL-CLOSED end to end: with a signer configured, an unimportable identity
module, an unknown/unattributable participant, or any signing error means the record
is not written and the action does not run. An audit record that silently lost its
signature is the same breach as one that was never written.
"""
import sys
import os
import json
import hashlib
import time
import fcntl

GENESIS = "0" * 64          # prev-hash of the first record
# Broker-stamped; never caller-supplied. `signer`/`sig` are here for the same reason as
# seq/prev: a record that can name its own signer can name someone else's.
RESERVED = ("seq", "prev", "ts", "hash", "signer", "sig")

# BIP-340 signs a 32-byte digest. Tagged-hash the canonical record bytes so an audit
# signature can never be replayed as a signature over anything else in this system
# (the boot self-test uses its own tag for the same reason).
SIG_TAG = "AgentOS/audit-record-v1"

SIGNER_ENV = "AGENT_OS_AUDIT_SIGNER"
REQUIRE_SIGNED_ENV = "AGENT_OS_AUDIT_REQUIRE_SIGNED"


class SigningUnavailable(RuntimeError):
    """The identity layer could not be reached or used. Never carries key material."""


def _identity():
    """Import modules/identity.py, or raise. NEVER returns a stub that no-ops.

    bin/audit ships to the Nix store as a LONE FILE (modules/audit-pkg.nix installs
    `${../bin/audit}`), so `../modules` relative to this file does not exist in
    production — the wrapper pins $AGENT_OS_MODULES. The repo-relative path is the
    development/battery fallback, tried second so a pinned production path always wins.
    """
    import importlib
    cands = []
    env = os.environ.get("AGENT_OS_MODULES")
    if env:
        cands.append(env)
    cands.append(os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                              "modules"))
    for d in cands:
        if os.path.isfile(os.path.join(d, "identity.py")):
            if d not in sys.path:
                sys.path.insert(0, d)
            try:
                return importlib.import_module("identity"), importlib.import_module("bip340")
            except Exception as e:                       # noqa: BLE001 — fail closed on ANY
                raise SigningUnavailable("identity module at %s is unusable: %s" % (d, e))
    raise SigningUnavailable(
        "identity module not found (looked in: %s) — set $AGENT_OS_MODULES" % ", ".join(cands))


def record_digest(rec):
    """32-byte digest over the record WITHOUT its signature fields.

    Signing covers seq/prev/ts as well as the payload: a signature over the payload
    alone would still verify after an actor moved the record to a different position
    in the chain, which is precisely the reorder the chain exists to catch.
    """
    _, bip340 = _identity()
    unsigned = {k: v for k, v in rec.items() if k not in ("signer", "sig")}
    return bip340.tagged_hash(SIG_TAG, canonical(unsigned).encode("utf-8"))


def log_path():
    d = os.environ.get("AGENT_OS_AUDIT_DIR", "/var/lib/agent-os/audit")
    return os.path.join(d, "audit.log")


def line_hash(line):
    return hashlib.sha256(line.encode("utf-8")).hexdigest()


def canonical(rec):
    # One record = exactly one physical line. sort_keys => deterministic hashing;
    # ensure_ascii keeps it single-line + 7-bit; json escapes any embedded newline,
    # so a hostile string value cannot forge a second log line.
    return json.dumps(rec, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def read_head(path):
    """Return (last_seq, last_line_hash) to chain onto; (-1, GENESIS) if empty/absent."""
    if not os.path.exists(path):
        return (-1, GENESIS)
    last = None
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n")
            if line:
                last = line
    if last is None:
        return (-1, GENESIS)
    rec = json.loads(last)
    return (int(rec["seq"]), line_hash(last))


def last_byte(path):
    """Last byte of the log, or None if empty/absent. Used to detect a torn tail."""
    try:
        with open(path, "rb") as f:
            try:
                f.seek(-1, os.SEEK_END)
            except OSError:
                return None            # zero-length file
            return f.read(1)
    except FileNotFoundError:
        return None


def utc_now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def cmd_append(argv):
    raw = sys.stdin.read()
    if not raw.strip():
        sys.stderr.write("audit append: empty record on stdin\n")
        return 2
    try:
        payload = json.loads(raw)
    except ValueError as e:
        sys.stderr.write("audit append: record is not valid JSON: %s\n" % e)
        return 2
    if not isinstance(payload, dict):
        sys.stderr.write("audit append: record must be a JSON object\n")
        return 2
    # Strip broker-reserved fields: a caller cannot forge seq/prev/ts/hash.
    for k in RESERVED:
        payload.pop(k, None)

    path = log_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    except OSError as e:
        sys.stderr.write("audit append: cannot create audit dir: %s\n" % e)
        return 3

    lockp = path + ".lock"
    try:
        lf = open(lockp, "w")
    except OSError as e:
        sys.stderr.write("audit append: cannot open lock: %s\n" % e)
        return 3
    try:
        fcntl.flock(lf, fcntl.LOCK_EX)
        # Torn tail: a crash between os.write and the newline durably landing leaves a
        # last line with no trailing "\n". read_head would chain onto that partial /
        # unterminated record, and the next os.write (O_APPEND at EOF) would concatenate
        # two records into ONE physical line — verify breaks forever while append keeps
        # exiting 0. Refuse instead: convert silent corruption into fail-closed.
        tail = last_byte(path)
        if tail is not None and tail != b"\n":
            sys.stderr.write("audit append: torn tail — last record lacks a trailing "
                             "newline; operator recovery required (refusing to append)\n")
            return 4
        seq, prev = read_head(path)
        rec = dict(payload)
        rec["seq"] = seq + 1
        rec["prev"] = prev
        rec["ts"] = utc_now()

        # Sign BEFORE the line is formed: the signature is part of the record, and the
        # chain hash below covers the signed line. Any failure here returns without
        # writing — an action whose record cannot be signed is as unaudited as one whose
        # record cannot be written, and no-log->no-execute does not distinguish them.
        signer = os.environ.get(SIGNER_ENV)
        if signer is not None:
            signer = signer.strip()
            # A SET-but-empty $AGENT_OS_AUDIT_SIGNER is refused rather than read as
            # "unsigned". Treating it as unsigned would turn a mis-exported variable into
            # a silent downgrade of every subsequent record — the one failure this whole
            # slice exists to make impossible.
            if not signer:
                sys.stderr.write("audit append: %s is set but empty — refusing to append "
                                 "unsigned under a configured signer\n" % SIGNER_ENV)
                return 5
            try:
                identity, _bip = _identity()
                sig = identity.sign_as(signer, record_digest(rec))
            except Exception as e:                       # noqa: BLE001 — fail closed on ANY
                sys.stderr.write("audit append: signing failed as %r (no-log->no-execute): "
                                 "%s\n" % (signer, e))
                return 5
            rec["signer"] = signer
            rec["sig"] = sig.hex()

        line = canonical(rec)
        h = line_hash(line)
        # O_APPEND: kernel positions each write at EOF atomically; never O_TRUNC, never
        # seek+write. fsync file AND directory so a returned success means the record
        # survived a crash — durability is what makes no-log->no-execute meaningful.
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            data = (line + "\n").encode("utf-8")
            n = os.write(fd, data)
            # POSIX write(2) may return a SHORT count WITHOUT raising (classic ENOSPC
            # mid-record). A partial line is both an un-audited action and a corrupt
            # chain, so a short write is a durability failure — raise into the OSError
            # handler below and fail closed. Silently returning 0 here is THE breach
            # no-log->no-execute exists to prevent.
            if n != len(data):
                raise OSError("short write: %d of %d bytes durable — record not written"
                              % (n, len(data)))
            os.fsync(fd)
        finally:
            os.close(fd)
        dfd = os.open(os.path.dirname(path), os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError as e:
        # Any write/fsync failure => the action is UNAUDITABLE => fail closed.
        sys.stderr.write("audit append: write failed (no-log->no-execute): %s\n" % e)
        return 3
    finally:
        fcntl.flock(lf, fcntl.LOCK_UN)
        lf.close()
    # The broker receives this head hash on stdout. Per Fable Step-2 FIX-3: the broker
    # (Step 5) MUST anchor it OUTSIDE the audit dir (e.g. broker state), so a
    # suffix-rewrite of the log — which the chain alone cannot detect — becomes
    # detectable before Step-7 `chattr +a` lands. Zero protocol cost; noted here.
    sys.stdout.write(h + "\n")
    return 0


def cmd_verify(argv):
    path = log_path()
    if not os.path.exists(path):
        # An absent log is a VALID empty chain — nothing has run yet.
        print("audit verify: empty (no log yet) — OK")
        return 0
    prev = GENESIS
    expect_seq = 0
    n = 0
    signed_n = 0
    # No-downgrade rule: once the log is signed it stays signed. This needs no operator
    # config on purpose — a suffix-rewrite whose fabricated records simply omit `sig`
    # would otherwise verify clean, which would make the signatures decorative.
    require_signed = os.environ.get(REQUIRE_SIGNED_ENV, "").strip() not in ("", "0")
    seen_signed = False
    with open(path, "r", encoding="utf-8") as f:
        for lineno, raw in enumerate(f, 1):
            line = raw.rstrip("\n")
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError as e:
                sys.stderr.write("audit verify: line %d not JSON: %s\n" % (lineno, e))
                return 1
            if rec.get("prev") != prev:
                sys.stderr.write("audit verify: BROKEN CHAIN at line %d (seq %s): prev mismatch — truncation/reorder\n"
                                 % (lineno, rec.get("seq")))
                return 1
            if rec.get("seq") != expect_seq:
                sys.stderr.write("audit verify: BROKEN SEQUENCE at line %d: got %s, expected %d\n"
                                 % (lineno, rec.get("seq"), expect_seq))
                return 1
            # Re-serialize canonically: confirms the on-disk bytes are the canonical
            # form, so an in-place edit (even one keeping seq/prev) is caught here.
            if canonical(rec) != line:
                sys.stderr.write("audit verify: line %d is not canonical form — edited\n" % lineno)
                return 1
            has_sig, has_signer = ("sig" in rec), ("signer" in rec)
            if has_sig != has_signer:
                sys.stderr.write("audit verify: line %d carries %s without %s — a half-signed "
                                 "record is not a signed record\n"
                                 % (lineno, "sig" if has_sig else "signer",
                                    "signer" if has_sig else "sig"))
                return 1
            if has_sig:
                if not isinstance(rec["signer"], str) or not isinstance(rec["sig"], str):
                    sys.stderr.write("audit verify: line %d signer/sig are not strings\n" % lineno)
                    return 1
                try:
                    identity, _bip = _identity()
                    ok = identity.verify(identity.npub_of(rec["signer"]),
                                         record_digest(rec), bytes.fromhex(rec["sig"]))
                except Exception as e:                   # noqa: BLE001 — fail closed on ANY
                    # Includes: identity layer unreachable, unknown participant, an
                    # unattributable key (identity's own fail-closed guards), malformed hex.
                    # An unCHECKABLE signature is treated as a failed one — the opposite
                    # would let an actor pass verify by deleting the signer's registry entry.
                    sys.stderr.write("audit verify: line %d signature could not be checked "
                                     "for signer %r: %s\n" % (lineno, rec.get("signer"), e))
                    return 1
                if not ok:
                    sys.stderr.write("audit verify: BAD SIGNATURE at line %d (seq %s, signer %r)\n"
                                     % (lineno, rec.get("seq"), rec["signer"]))
                    return 1
                seen_signed = True
                signed_n += 1
            elif seen_signed or require_signed:
                sys.stderr.write("audit verify: UNSIGNED record at line %d (seq %s) — %s\n"
                                 % (lineno, rec.get("seq"),
                                    "the log is signed from an earlier record; signing cannot "
                                    "be dropped mid-chain" if seen_signed else
                                    "%s demands a signature on every record" % REQUIRE_SIGNED_ENV))
                return 1
            prev = line_hash(line)
            expect_seq += 1
            n += 1
    print("audit verify: OK — %d records, chain intact%s"
          % (n, ", %d signed" % signed_n if signed_n else ""))
    return 0


def cmd_tail(argv):
    n = 20
    if argv:
        try:
            n = int(argv[0])
        except ValueError:
            sys.stderr.write("audit tail: N must be an integer\n")
            return 2
    path = log_path()
    if not os.path.exists(path):
        return 0
    with open(path, "r", encoding="utf-8") as f:
        lines = [ln.rstrip("\n") for ln in f if ln.strip()]
    for ln in lines[-n:]:
        print(ln)
    return 0


def main(argv):
    if not argv:
        sys.stderr.write(__doc__)
        return 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "append":
        return cmd_append(rest)
    if cmd == "verify":
        return cmd_verify(rest)
    if cmd == "tail":
        return cmd_tail(rest)
    sys.stderr.write("audit: unknown command '%s' (append|verify|tail)\n" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
