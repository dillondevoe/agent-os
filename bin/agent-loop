#!/usr/bin/env python3
"""agent-loop — the tool-calling BRAIN for Agent OS (v0.2 A2: route through the wall).

Wraps the local Qwen in a function-calling loop using Ollama's NATIVE tools API
(`/api/chat` accepts a `tools` array and returns structured `message.tool_calls`),
so we never regex ReAct prose out of model text — Ollama does the parse. agent-shell
execs whatever `$BRAIN` names; point BRAIN here (or let agent-shell prefer it) to
get a model that can *ask for actions*, not only talk.

WHAT A2 IS (Geist v0.2 spec §1/§3, Rabbot A2 directive): the loop now routes EVERY
  model tool-call through THE WALL — `mcp parse | broker run`. `mcp parse` is the
  structural JSON-RPC classifier (fail-closed); `broker run` is the trusted decision
  point (tier, taint, arg-schema, origin, confirm). The tool surface is derived at
  startup from the LIVE registry via a `capabilities.list` call through that same
  wall (no hardcoded tool list). A1's inert `echo` stand-in is gone; the round-trip
  it proved — call, result feeds back, model continues — now carries real caps.

WHERE THIS SITS (the load-bearing design fact — Geist §1):
  agent-loop lives on the UNTRUSTED side of the wall. It translates and shuttles
  bytes and makes ZERO security decisions. It reaches outside this process in exactly
  ONE way: it execs the wall pipeline (mcp+broker, resolved as store-pinned siblings)
  to hand the request across and read the verdict back — no other filesystem, no
  network beyond the local Ollama it wraps, no shell (the pipe is wired natively, the
  model's bytes never touch a shell interpreter). A bug here can produce a garbage
  tool request — which dies fail-closed at mcp/broker — but can NEVER widen authority:
  `dispatch()` returns an ALLOW only for a well-formed broker data_result envelope, so
  a missing/hung/garbled wall and a broker deny collapse to the SAME fail-closed denial.

RELIABILITY (Geist §3): 7B-class function-calling is mediocre under a big tool
  surface, so the surface stays lean (the registry's handful of caps). Malformed/
  hallucinated/denied calls are DATA, not errors: each comes back to the model as a
  structured tool result and it may retry. A hard cap (3 denials per user turn) stops
  an infinite deny-loop from burning the session — the loop then takes one final turn
  with tools withheld so the model explains, in plain words, what it wanted and why it
  couldn't.

stdlib only (urllib) so it runs anywhere Python does, incl. the built VM.
"""
import json, os, re, subprocess, sys, urllib.request, urllib.error, http.client

HOST  = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434").rstrip("/")
if not HOST.startswith(("http://", "https://")):     # env-sourced, not model — but harden as knobs multiply
    sys.stderr.write(f"[agent-loop] refusing non-http(s) OLLAMA_HOST: {HOST!r}\n"); sys.exit(2)
MODEL = os.environ.get("OLLAMA_MODEL", "qwen3.5:9b")
SYSTEM = os.environ.get(
    "BRAIN_SYSTEM",
    "You are the resident agent of this computer (Agent OS). You run locally on the "
    "user's own hardware — no cloud. Be concise, direct, and honest about what you can "
    "and cannot do. The tools listed in this request are your ONLY way to act on the "
    "machine, and every call goes through a security broker that may require confirmation "
    "or refuse it. A refusal comes back to you as data — read it and adapt rather than "
    "retrying the same call blindly. If you need something none of your tools offer, say "
    "so plainly rather than inventing a tool that does not exist.")

C_YOU = "\033[38;5;179m"; C_AI = "\033[38;5;79m"; C_DIM = "\033[38;5;244m"; C0 = "\033[0m"

MAX_TURNS     = 24    # bound history re-sent each turn over a long session
MAX_TOOL_HOPS = 8     # max tool-executing model turns per user message (halts a happy-path tool spin)
MAX_DENIALS   = 3     # dispatch/broker denials per user turn before we stop tool-calling (Geist §3)
MAX_RESP_BYTES = 4_000_000   # bound a hostile/huge /api/chat body so one turn can't balloon memory

_CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f\x80-\x9f]")  # C0 + DEL + all C1 (ESC \x1b, CSI \x9b, DCS \x90, OSC \x9d); keeps \t and \n
def _clean(s):
    """Strip terminal control/escape bytes from model- or server-controlled text before
    it reaches the login tty (ESC/CSI/OSC injection defense). Keeps \\t and \\n."""
    return _CTRL.sub("", s if isinstance(s, str) else str(s))

# ── the wall (A2: `mcp parse | broker run`) ──────────────────────────────────────────
# THE SEAM. Every model tool-call is marshalled into a JSON-RPC 2.0 tools/call line and
# piped through the two-stage wall: `mcp parse` (structural classifier, fail-closed) then
# `broker run` (the trusted decision point — tier, taint, arg-schema, origin, confirm). The
# loop is the UNTRUSTED side: it makes ZERO security decisions and can NEVER manufacture an
# allow. mcp+broker are resolved as siblings of this file by default and overridable ONLY by
# the trusted boot (never by the model) via env — production nix pins them to store paths,
# the same discipline the broker's own seams (AGENT_OS_INVOKE_SEAM, …) already use.
_BINDIR = os.path.dirname(os.path.realpath(__file__))
MCP     = os.environ.get("AGENT_OS_MCP",    os.path.join(_BINDIR, "mcp"))
BROKER  = os.environ.get("AGENT_OS_BROKER", os.path.join(_BINDIR, "broker"))
WALL_TIMEOUT_S = 90       # a hung wall must never freeze the login shell → timeout ≡ deny
_req_seq = 0              # monotonic JSON-RPC id; single-flight (one request per wall run)

def _wall(request):
    """Run ONE JSON-RPC request object through `mcp parse | broker run` and return the
    broker's single response dict — or None on ANY failure (the caller then denies,
    fail-closed). Two NATIVE pipes, no shell: the model's bytes never reach a shell
    interpreter. Both stages run under THIS python3 (sys.executable) so neither depends on
    a `#!/usr/bin/env python3` shebang resolving (the nix-sandbox ENOEXEC trap)."""
    line = (json.dumps(request, separators=(",", ":"), ensure_ascii=True) + "\n").encode()
    p_mcp = p_brk = None
    out = b""
    try:
        p_mcp = subprocess.Popen([sys.executable, MCP, "parse"],
                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL)
        p_brk = subprocess.Popen([sys.executable, BROKER, "run"],
                                 stdin=p_mcp.stdout, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL)
        p_mcp.stdout.close()          # broker owns the read end → it EOFs when mcp exits
        try:
            p_mcp.stdin.write(line)
            p_mcp.stdin.close()       # tiny single line, no reader deadlock; EOF ends mcp
        except (BrokenPipeError, OSError):
            pass                      # mcp died early → broker EOFs → no verdict → deny below
        out, _ = p_brk.communicate(timeout=WALL_TIMEOUT_S)
    except Exception as e:
        sys.stderr.write(_clean(f"[agent-loop] wall error: {e}") + "\n")
        return None
    finally:
        for p in (p_brk, p_mcp):      # never leak a hung/half-dead wall process
            if p and p.poll() is None:
                try: p.kill()
                except Exception: pass
            if p:
                try: p.wait(timeout=5)
                except Exception: pass
    for raw in (out or b"").splitlines():   # broker emits one canonical line per verdict
        s = raw.strip()
        if not s:
            continue
        try:
            return json.loads(s.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return None               # garbage from the wall → deny (fail-closed)
    return None                       # no verdict at all → deny

def dispatch(name, arguments):
    """Route a model tool-call THROUGH THE WALL → return (ok: bool, result: dict), the same
    contract converse() already speaks. This function makes ZERO security decisions: `ok` is
    True IFF the broker returned an ALLOW — a well-formed `data_result` envelope (ok:true).
    A broker DENY, or any wall failure (unreachable / hung / crashed / garbled), is ok=False,
    a denial the model sees as data and may adapt to. The loop can NEVER turn a deny into an
    allow (HARD REQ 4). The content_type:"data" envelope is emitted TRUSTED-SIDE by the
    broker; the loop no longer stamps it."""
    global _req_seq
    _req_seq += 1
    resp = _wall({"jsonrpc": "2.0", "id": _req_seq, "method": "tools/call",
                  "params": {"name": name, "arguments": arguments}})
    if not isinstance(resp, dict):
        return False, {"error": "wall unreachable or returned no verdict (fail-closed deny)"}
    if resp.get("ok") is True and isinstance(resp.get("result"), dict):
        # ALLOW: hand the broker's data envelope straight back — {content_type, capability_ok,
        # content}. capability_ok=False (e.g. a mem.recall miss) is STILL an allow: the model
        # got a data answer, not a wall refusal, so it does NOT count toward the deny cap.
        return True, resp["result"]
    # Denial: a broker deny envelope carries a TRUSTED (broker-authored, never attacker) error
    # object — pass it through so the model learns WHY (attacker bytes are confined to the
    # data_result `content`, never error.message; that is the broker's §4.9 guarantee).
    err = resp.get("error") if isinstance(resp.get("error"), dict) else \
        {"message": "denied (malformed wall response)"}
    return False, {"error": err}

def _ollama_tool(name, description):
    """One Ollama function-tool entry. Parameters are deliberately PERMISSIVE ({type:object},
    no property schema, no required list): the broker's check_args is the SOLE arg-schema
    authority (§4.3). Advertising a local schema would only teach the 7B to self-censor args
    the wall would accept — worse, a WRONG local schema could suppress a valid call. So the
    loop stays schema-free and lets every structurally-formed call reach the wall to be judged."""
    return {"type": "function",
            "function": {"name": name, "description": description or name,
                         "parameters": {"type": "object"}}}

def discover_tools():
    """Build the model's tool surface from the LIVE registry via ONE `capabilities.list` call
    THROUGH THE WALL (Geist §3: tools derive from the registry, not a hardcode). The loop makes
    no security decision here — it only renders what the broker reports the agent may ask for.
    On ANY failure (wall down, registry unreadable → capabilities.list denies, malformed
    content) it returns [] and the brain runs as a pure conversational floor with NO tools —
    fail-closed and non-fatal (never crash the login shell over a missing wall)."""
    ok, result = dispatch("capabilities.list", {})
    if not ok or not isinstance(result, dict) or not isinstance(result.get("content"), str):
        sys.stderr.write("[agent-loop] capabilities.list unavailable at the wall — "
                         "running with NO tools (chat only)\n")
        return []
    try:
        caps = json.loads(result["content"]).get("capabilities", [])
    except (ValueError, AttributeError):
        caps = []
    tools = []
    for c in caps:
        if isinstance(c, dict) and isinstance(c.get("name"), str):
            summary = c.get("summary") if isinstance(c.get("summary"), str) else ""
            tools.append(_ollama_tool(c["name"], summary))
    return tools

def _post(path, payload):
    req = urllib.request.Request(
        HOST + path, data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"}, method="POST")
    return urllib.request.urlopen(req, timeout=120)

def check():
    """Preflight for agent-shell: exit 0 iff Ollama is reachable AND advertises at least
    one model, else non-zero — same contract as brain-ollama --check. Lets the login shell
    decide whether to hand off here or fall back (brain-ollama floor, then mem REPL) so we
    never exec into a brain that cannot talk and crash-loop getty's autologin. Short timeout
    so a down server barely delays login."""
    try:
        resp = urllib.request.urlopen(HOST + "/api/tags", timeout=4)
        data = json.loads(resp.read(1_000_000))   # bound: a hostile /api/tags must not balloon login preflight
    except Exception:
        return 1
    return 0 if data.get("models") else 1

def chat_once(history, tools):
    """One /api/chat turn, stream=False (we need the structured tool_calls in one piece).
    Returns the `message` object, or None on any transport/decode failure (caller degrades
    gracefully — this brain is exec'd AS the login program and must never tear down)."""
    payload = {"model": MODEL, "messages": history, "stream": False}
    if tools:
        payload["tools"] = tools
    try:
        resp = _post("/api/chat", payload)
        data = json.loads(resp.read(MAX_RESP_BYTES))
    except urllib.error.URLError as e:
        sys.stderr.write(_clean(f"\n[agent-loop] cannot reach Ollama at {HOST}: {e}") + "\n")
        return None
    except (OSError, http.client.HTTPException, json.JSONDecodeError, ValueError) as e:
        sys.stderr.write(_clean(f"\n[agent-loop] bad response from Ollama: {e}") + "\n")
        return None
    return data.get("message", {}) or {}

def _call_name_args(call):
    """Normalize one Ollama tool_call → (name, args_dict). Ollama usually hands args back as
    an object, but tolerate the string form some model paths emit; never trust the shape."""
    fn = call.get("function", {}) or {}
    name = _clean(fn.get("name", ""))
    args = fn.get("arguments", {})
    if isinstance(args, str):
        try: args = json.loads(args)
        except Exception: args = {}
    if not isinstance(args, dict):
        args = {}
    return name, args

def _emit(text):
    if text:
        sys.stdout.write(f"{C_AI}{text}{C0}\n"); sys.stdout.flush()

def _emit_trace(name, ok):
    # one dim line per tool hop so the human SEES the hand move (and any deny)
    sys.stdout.write(f"{C_DIM}  ↳ tool: {_clean(name) or '?'} → {'ok' if ok else 'denied'}{C0}\n")
    sys.stdout.flush()

def converse(history, tools):
    """Drive tool-calling turns for one user message until the model gives a final text
    answer (no tool_calls), or the deny/hop budget is spent. Appends every turn to `history`
    (so the model keeps context). Returns the final assistant text, or None on transport loss."""
    denials = 0
    for _hop in range(MAX_TOOL_HOPS):
        msg = chat_once(history, tools)
        if msg is None:
            return None
        calls = msg.get("tool_calls") or []
        text  = _clean(msg.get("content", "") or "")
        # record the assistant turn WITH its tool_calls so the following tool messages have context
        history.append({"role": "assistant", "content": text, "tool_calls": calls}
                       if calls else {"role": "assistant", "content": text})
        if not calls:
            _emit(text)
            return text                       # final answer — done
        if text:
            _emit(text)                       # models often narrate before/with a call
        for call in calls:
            name, args = _call_name_args(call)
            ok, result = dispatch(name, args)
            if not ok:
                denials += 1
            # feed the result back as a role:"tool" message; keep the data envelope intact
            history.append({"role": "tool", "tool_name": name, "content": json.dumps(result)})
            _emit_trace(name, ok)
        if denials >= MAX_DENIALS:
            break                             # stop tool-calling (Geist §3) — explain below
    # Budget spent (deny cap or hop cap). Take ONE final turn with tools WITHHELD so the model
    # must answer in prose — and treat it as terminal: any tool_calls it still emits are IGNORED,
    # never dispatched. That is the structural "the loop stops calling tools" guarantee.
    final = chat_once(history, None)
    if final is None:
        _emit(f"{C_DIM}[agent-loop] stopped after {denials} tool denial(s); couldn't reach the "
              f"model to explain. Try rephrasing, or ask me without needing a tool.{C0}")
        return None
    text = _clean(final.get("content", "") or "")
    history.append({"role": "assistant", "content": text})
    _emit(text)
    return text

def main():
    tools = discover_tools()        # live registry surface via capabilities.list through the wall
    names = ", ".join(t["function"]["name"] for t in tools) or "none (chat only)"
    sys.stdout.write(f"{C_DIM}brain: {MODEL} @ {HOST} (local — no cloud) · tools: {names}{C0}\n")
    history = [{"role": "system", "content": SYSTEM}]
    while True:
        sys.stdout.write(f"{C_YOU}you ›{C0} "); sys.stdout.flush()
        line = sys.stdin.readline()
        if not line:                # EOF (piped input exhausted / Ctrl-D)
            sys.stdout.write("\n"); break
        msg = line.strip()
        if msg == "":               # blank line: reprompt, don't send an empty turn
            continue
        if msg in ("exit", "quit", ":q"):
            break
        history.append({"role": "user", "content": msg})
        reply = converse(history, tools)
        if reply is None:           # transport lost — don't spin
            break
        if len(history) > 1 + 4 * MAX_TURNS:   # bound history (tool turns inflate it faster than chat)
            history[:] = history[:1] + history[-4 * MAX_TURNS:]

if __name__ == "__main__":
    if "--check" in sys.argv[1:]:
        sys.exit(check())
    try:
        main()
    except KeyboardInterrupt:
        sys.stdout.write("\n")
