{
 "family": "routing",
 "description": "Jev-style picker: one of N named handlers. Measures whether a small model can be the front stage.",
 "system": "You are the router in front of a local assistant on the owner's computer. For each request call route() once with the one handler that fits: local-answer = answer from what you know, no action; tool = a single desktop/file/system action from the existing tool set (open, focus, move, close, show a file, system settings); build-app = the owner wants a NEW small app, script or recurring automation built; refuse-or-ask = unsafe, needs a credential or secret, or too ambiguous to act, so ask first. Do not explain.",
 "tools": [
  {
   "type": "function",
   "function": {
    "name": "route",
    "description": "Pick exactly one handler for the request.",
    "parameters": {
     "type": "object",
     "properties": {
      "handler": {
       "type": "string",
       "enum": [
        "local-answer",
        "tool",
        "build-app",
        "refuse-or-ask"
       ]
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "handler"
     ]
    }
   }
  }
 ],
 "tasks": [
  {
   "id": "rt-capital",
   "prompt": "what's the capital of Portugal?",
   "expect": {
    "call": {
     "tool": "route",
     "args": {
      "handler": {
       "in": [
        "local-answer"
       ]
      }
     }
    }
   },
   "fake": {
    "content": "",
    "tool_calls": [
     {
      "function": {
       "name": "route",
       "arguments": {
        "handler": "local-answer"
       }
      }
     }
    ]
   }
  },
